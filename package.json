{
  "name": "engineering-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "읽기 중심 공학 지식 라이브러리 (정적 단일 페이지)",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/validate.mjs && node scripts/build.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "new": "node scripts/new-article.mjs"
  },
  "devDependencies": {
    "katex": "0.16.9",
    "marked": "12.0.2",
    "three": "0.160.0"
  }
}
